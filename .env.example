# =========================================================
# GramVayu AI Assistant Configuration
# =========================================================

# Hugging Face Free Serverless API Token (from huggingface.co/settings/tokens)
HF_TOKEN=

# Default LLM: Qwen 2.5 (Alibaba Cloud)
# Options: Qwen/Qwen2.5-7B-Instruct, Qwen/Qwen2.5-72B-Instruct, meta-llama/Llama-3.1-8B-Instruct
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Google Gemini API Key (Alternative/fallback: aistudio.google.com)
GEMINI_API_KEY=
